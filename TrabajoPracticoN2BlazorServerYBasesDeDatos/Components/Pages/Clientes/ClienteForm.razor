@page "/clientes/nuevo"
@page "/clientes/editar/{Id:int}"
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Models
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Services
@inject ClienteService _clienteService
@inject NavigationManager _navigationManager

<PageTitle>@(Id == null ? "Nuevo Cliente" : "Editar Cliente")</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@(Id == null ? "Registrar Nuevo Cliente" : "Modificar Datos del Cliente")</h4>
        </div>
        <div class="card-body p-4">
            <EditForm Model="cliente" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Nombre</label>
                        <InputText @bind-Value="cliente.Nombre" class="form-control" placeholder="Ej: Juan" />
                        <ValidationMessage For="@(() => cliente.Nombre)" class="text-danger small" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Apellido</label>
                        <InputText @bind-Value="cliente.Apellido" class="form-control" placeholder="Ej: Pérez" />
                        <ValidationMessage For="@(() => cliente.Apellido)" class="text-danger small" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Teléfono</label>
                        <InputText @bind-Value="cliente.Telefono" class="form-control" placeholder="Ej: 2954-123456" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Correo Electrónico</label>
                        <InputText @bind-Value="cliente.Email" class="form-control" type="email" placeholder="ejemplo@correo.com" />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a href="/clientes" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private Cliente cliente = new Cliente();

    protected override async Task OnInitializedAsync()
    {
        // Si recibimos un Id por la URL, significa que estamos editando
        if (Id.HasValue)
        {
            var clienteDb = await _clienteService.GetClienteByIdAsync(Id.Value);
            if (clienteDb != null)
            {
                cliente = clienteDb;
            }
        }
    }

    private async Task Guardar()
    {
        if (Id.HasValue)
        {
            await _clienteService.UpdateClienteAsync(cliente);
        }
        else
        {
            await _clienteService.AddClienteAsync(cliente);
        }
        
        // Redirigimos a la lista después de guardar
        _navigationManager.NavigateTo("/clientes");
    }
}