@page "/clientes"
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Models
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Services
@inject ClienteService _clienteService

<PageTitle>Clientes</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Clientes</h2>
        <a href="/clientes/nuevo" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Cliente
        </a>
    </div>

    @if (clientes == null)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    }
    else if (!clientes.Any())
    {
        <div class="alert alert-info">No hay clientes registrados en el sistema.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in clientes)
                    {
                        <tr>
                            <td>@cliente.Id</td>
                            <td>@cliente.Nombre</td>
                            <td>@cliente.Apellido</td>
                            <td>@cliente.Telefono</td>
                            <td>@cliente.Email</td>
                            <td class="text-center">
                                <a href="/clientes/editar/@cliente.Id" class="btn btn-sm btn-warning me-2">Editar</a>
                                <button class="btn btn-sm btn-danger" @onclick="() => BorrarCliente(cliente.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        clientes = await _clienteService.GetClientesAsync();
    }

    private async Task BorrarCliente(int id)
    {
        // Más adelante podemos agregar un cartel de confirmación
        await _clienteService.DeleteClienteAsync(id);
        await CargarClientes(); // Recargar la tabla
    }
}