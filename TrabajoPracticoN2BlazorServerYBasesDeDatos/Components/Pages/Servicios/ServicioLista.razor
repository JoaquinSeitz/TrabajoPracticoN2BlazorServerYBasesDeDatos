@page "/servicios"
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Models
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Services
@inject ServicioService _servicioService

<PageTitle>Servicios</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Catálogo de Servicios</h2>
        <a href="/servicios/nuevo" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Servicio
        </a>
    </div>

    @if (servicios == null)
    {
        <div class="spinner-border text-primary" role="status"></div>
    }
    else if (!servicios.Any())
    {
        <div class="alert alert-info">No hay servicios registrados.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var servicio in servicios)
                    {
                        <tr>
                            <td>@servicio.Id</td>
                            <td>@servicio.Nombre</td>
                            <td>@servicio.Descripcion</td>
                            <td>$@servicio.Precio</td>
                            <td class="text-center">
                                <a href="/servicios/editar/@servicio.Id" class="btn btn-sm btn-warning me-2">Editar</a>
                                <button class="btn btn-sm btn-danger" @onclick="() => BorrarServicio(servicio.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Servicio>? servicios;

    protected override async Task OnInitializedAsync()
    {
        await CargarServicios();
    }

    private async Task CargarServicios()
    {
        servicios = await _servicioService.GetServiciosAsync();
    }

    private async Task BorrarServicio(int id)
    {
        await _servicioService.DeleteServicioAsync(id);
        await CargarServicios();
    }
}