@page "/turnos"
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Models
@using TrabajoPracticoN2BlazorServerYBasesDeDatos.Services
@inject TurnoService _turnoService

<PageTitle>Turnos</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Agenda de Turnos</h2>
        <a href="/turnos/nuevo" class="btn btn-primary">
            <i class="bi bi-calendar-plus"></i> Asignar Turno
        </a>
    </div>

    @if (turnos == null)
    {
        <div class="spinner-border text-primary" role="status"></div>
    }
    else if (!turnos.Any())
    {
        <div class="alert alert-info">No hay turnos programados.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Cliente</th>
                        <th>Servicio</th>
                        <th>Observaciones</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var turno in turnos)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@turno.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(turno.Cliente?.Nombre) @(turno.Cliente?.Apellido)</td>
                            <td>@(turno.Servicio?.Nombre)</td>
                            <td>@turno.Observaciones</td>
                            <td class="text-center">
                                <a href="/turnos/editar/@turno.Id" class="btn btn-sm btn-warning me-2">Editar</a>
                                <button class="btn btn-sm btn-danger" @onclick="() => BorrarTurno(turno.Id)">Cancelar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Turno>? turnos;

    protected override async Task OnInitializedAsync()
    {
        await CargarTurnos();
    }

    private async Task CargarTurnos()
    {
        turnos = await _turnoService.GetTurnosAsync();
    }

    private async Task BorrarTurno(int id)
    {
        await _turnoService.DeleteTurnoAsync(id);
        await CargarTurnos();
    }
}